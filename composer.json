{
    "name": "bag2/cookie",
    "description": "Cookie functions over PSR-7 and setcookie() function.",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1",
        "ext-pcre": "*",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "badoo/soft-mocks": "^4.0",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "nyholm/psr7": "^1.8",
        "php-http/psr7-integration-tests": "^1.5",
        "phpstan/phpstan": "^2.1",
        "phpunit/php-code-coverage": "^12.5",
        "phpunit/phpunit": "^9.6 || ^12.0",
        "psr/http-factory": "^1.0"
    },
    "autoload": {
        "files": ["src/functions.php"],
        "psr-4": {
            "Bag2\\Cookie\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bag2\\Cookie\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "patches-dev": {
            "badoo/soft-mocks": {
                "Adapt SoftMocks to Composer 2.0": {
                    "source": "patches/soft-mocks/SoftMocks.php.patch",
                    "version": ">= 3.1.1"
                }
            }
        }
    }
}
